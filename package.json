{
  "name": "@carbonenginejs/server",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental server-side space simulation for CarbonEngineJS",
  "type": "module",
  "exports": {
    ".": "./dist/destiny/index.js",
    "./destiny": "./dist/destiny/index.js",
    "./destiny/net/server": "./dist/destiny/net/server/index.js",
    "./destiny/net/client": "./dist/destiny/net/client/index.js",
    "./destiny/geometry": "./dist/destiny/geometry/index.js",
    "./destiny/partition": "./dist/destiny/partition/index.js",
    "./destiny/_util/settings": "./dist/destiny/_util/settings.js",
    "./destiny/_util/signal": "./dist/destiny/_util/signal.js",
    "./destiny/_util/timing": "./dist/destiny/_util/timing.js"
  },
  "files": [
    "dist/",
    "destiny/",
    "docs/",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@carbonenginejs/runtime": "file:../runtime/npm"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7"
  }
}
